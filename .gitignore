# Rust
/target/
**/target/
*.rs.bk
# NOTE: Cargo.lock IS committed — this is a binary (Tauri desktop app),
# not a pure library, so pinning the exact dep graph matters for
# reproducibility and for `cargo test --locked` in CI.

# Node
node_modules/
dist/
.next/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/WixTools/
# Icons: the three PNGs referenced by `tauri.conf.json`'s `bundle.icon`
# array are required for `cargo tauri build` to compile (the proc-macro
# reads them at build time). They are committed. Platform-specific
# bundle artefacts (.icns, .ico) that `cargo tauri icon` would generate
# are not committed — regenerate locally when shipping an installer.
apps/desktop/src-tauri/icons/*
!apps/desktop/src-tauri/icons/32x32.png
!apps/desktop/src-tauri/icons/128x128.png
!apps/desktop/src-tauri/icons/128x128@2x.png
# Generated by `tauri-build` at compile time — rebuilt deterministically
# from tauri.conf.json, so checking these in would just create merge
# noise on every config tweak.
apps/desktop/src-tauri/gen/
# NOTE: apps/desktop/src-tauri/Cargo.lock IS committed (see top-of-file rule:
# this is a binary). Leaving it unlocked let transitive deps drift and broke a
# clean build (cookie 0.18.1 vs time 0.3.52). The lock pins the graph; CI runs
# the Tauri job with --locked. Re-lock intentionally via `cargo update`.

# Build artifacts
*.dmg
*.AppImage
*.deb
*.msi
*.exe

# Test & coverage
coverage/
*.lcov
tarpaulin-report.html

# Claude Code local agent state (sessions, worktrees, transcripts).
# Must never be committed — nested git repos (worktrees) would register as
# broken submodules and run logs are noisy / potentially sensitive.
# Exception: .claude/skills/ holds shareable project skills (e.g. /test-app)
# and IS committed so the whole team gets them on checkout.
.claude/*
!.claude/skills/
# The shared dev-quality system (committed so the whole team gets it):
!.claude/commands/
!.claude/agents/
!.claude/hooks/
!.claude/settings.json
!.claude/README.md

# Local build logs from `pnpm tauri dev` runs — never commit.
devlog*.txt

# Locally-cloned sibling repos placed under this project root
# (e.g. the pitch-deck repo cloned here for cross-working).
# They have their own history.
ai-music-companion-pitch/

# Pitch-deck / strategy drafts that live in the pitch repo
# (perice-pope/ai-music-companion-pitch), not this one.
/pitch-deck-v2.html
/AI_Music_Companion_Platform_Strategy_v3.docx
