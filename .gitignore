# Rust
/target/
**/target/
*.rs.bk
# NOTE: Cargo.lock IS committed — this is a binary (Tauri desktop app),
# not a pure library, so pinning the exact dep graph matters for
# reproducibility and for `cargo test --locked` in CI.

# Node
node_modules/
dist/
.next/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/WixTools/
apps/desktop/src-tauri/icons/
# Generated by `tauri-build` at compile time — rebuilt deterministically
# from tauri.conf.json, so checking these in would just create merge
# noise on every config tweak.
apps/desktop/src-tauri/gen/
# Tauri subcrate Cargo.lock. The top-level workspace's Cargo.lock is
# committed; the Tauri subcrate runs as its own workspace (own giant
# dep graph) and re-locks on every build, so committing it adds ~6k
# lines of churn to every PR touching src-tauri.
apps/desktop/src-tauri/Cargo.lock

# Build artifacts
*.dmg
*.AppImage
*.deb
*.msi
*.exe

# Test & coverage
coverage/
*.lcov
tarpaulin-report.html

# Claude Code local agent state (sessions, worktrees, transcripts).
# Must never be committed — nested git repos would register as broken
# submodules and run logs are noisy / potentially sensitive.
.claude/

# Locally-cloned sibling repos placed under this project root
# (e.g. the pitch-deck repo cloned here for cross-working).
# They have their own history.
ai-music-companion-pitch/

# Pitch-deck / strategy drafts that live in the pitch repo
# (perice-pope/ai-music-companion-pitch), not this one.
/pitch-deck-v2.html
/AI_Music_Companion_Platform_Strategy_v3.docx
